# Copy to .env and edit. docker compose reads .env when the container is created:
# apply changes with `make restart`, no rebuild needed.

# Required: at least 16 characters. Generate one with: openssl rand -hex 32
API_KEY=

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Address the API listens on, port 8000. Loopback by default: put a reverse proxy with TLS in front of it.
# Set an address of the host (e.g. its management LAN) to reach it directly; 0.0.0.0 is every address.
#UVICORN_HOST=127.0.0.1
