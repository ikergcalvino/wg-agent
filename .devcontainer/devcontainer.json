{
  "name": "wg-agent",
  "build": { "dockerfile": "Dockerfile" },
  // Its own network namespace, so WireGuard interfaces here never touch the host's. NET_ADMIN is
  // what WireGuard needs; docker-in-docker below also makes the container privileged.
  "runArgs": ["--cap-add=NET_ADMIN"],
  "features": {
    // Docker inside the container, so `make integration` works here too.
    // moby: false installs Docker CE, since moby packages do not exist for Debian trixie.
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false }
  },
  "containerEnv": {
    "DEVCONTAINER": "1",
    "API_KEY": "dev-api-key-0123456789",
    "LOG_LEVEL": "DEBUG",
    // Keep the container's virtualenv out of the workspace, so it never clashes with a host .venv.
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv"
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "astral-sh.ty"],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
